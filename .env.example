# --- Google OAuth ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorised redirect URIs must include:
#   https://schedule.nigel-smith.dev/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The single account permitted to reach /admin. Compared case-insensitively.
ADMIN_EMAIL=nigel.nds.smith@gmail.com

# Session cookie signing key. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Site -----------------------------------------------------------------
# Public origin. Used for OAuth redirects, ICS feed URLs and event UIDs.
SITE_URL=https://schedule.nigel-smith.dev

# IANA zone every date is rendered in. Storage is always UTC.
SCHEDULER_TIMEZONE=America/New_York

# --- Storage --------------------------------------------------------------
DATABASE_PATH=./data/scheduler.db

# --- Subscribed calendars -------------------------------------------------
# A calendar with a subscription URL is re-fetched on this interval by the
# poller started in instrumentation.ts. Set SYNC_ENABLED=false to turn the
# background poller off entirely; the admin "Sync now" button still works.
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30

# Subscription URLs on a private network (localhost, 10.x, 192.168.x, a NAS on
# the LAN) are refused by default, so a mistyped address cannot make the server
# fetch something on its own network. Set true to allow them.
SYNC_ALLOW_PRIVATE_HOSTS=false

# --- Deployment (docker-compose only) -------------------------------------
# How often Watchtower checks GHCR for a new image, in seconds.
WATCHTOWER_POLL_INTERVAL=300

# --- Model Context Protocol (MCP) ----------------------------------------
# Master switch for remote MCP server at /mcp
MCP_ENABLED=false
# Required if MCP_ENABLED=true: openssl rand -base64 32
MCP_TOKEN_SECRET=
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
# Comma-separated list of allowed client redirect URIs (defaults to Anthropic's callbacks)
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
MCP_MAX_RESULTS=100
MCP_DEFAULT_WINDOW_DAYS=7

